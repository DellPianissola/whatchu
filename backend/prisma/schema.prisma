// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  password      String
  birthDate     DateTime?
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relacionamentos
  profile              Profile?
  verificationTokens   VerificationToken[]

  @@map("users")
}

// Cadastro pendente. Vira User ao verificar o email; expira em ~24h.
model PendingRegistration {
  id        String   @id @default(uuid())
  email     String
  username  String
  password  String   // hash bcrypt
  birthDate DateTime?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("pending_registrations")
}

model Profile {
  id                String    @id @default(uuid())
  name              String
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardedAt       DateTime?
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relacionamentos
  movies                Movie[]
  sentFriendships       Friendship[] @relation("sentFriendships")
  receivedFriendships   Friendship[] @relation("receivedFriendships")

  @@map("profiles")
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  requester   Profile  @relation("sentFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   Profile  @relation("receivedFriendships", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  type        MovieType
  description String?
  poster      String?
  year        Int?
  duration    Int?
  genres      String[]
  rating      Decimal? @db.Decimal(3, 1)
  priority    Priority @default(MEDIUM)
  watched     Boolean  @default(false)
  watchedAt   DateTime?
  externalId  String?
  providers           Int[]     @default([])
  providersUpdatedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addedById   String
  addedBy     Profile  @relation(fields: [addedById], references: [id], onDelete: Cascade)

  // IDs do TMDB colidem entre movie e tv — sem o type, um filme bloquearia a série homônima.
  @@unique([addedById, externalId, type])
  @@index([addedById])
  @@index([type])
  @@index([priority])
  @@index([watched])
  @@map("movies")
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  newEmail  String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum MovieType {
  MOVIE
  SERIES
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

